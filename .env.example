# ── обязательное ────────────────────────────────────────────────────
DB_PASSWORD=смените_на_случайный_пароль
PANEL_DOMAIN=panel.example.com
SUB_DOMAIN=sub.example.com

# Публичный адрес подписок — попадает в ссылки клиентам.
SUB_PUBLIC_URL=https://sub.example.com
BRAND_NAME=My VPN

# ── Telegram-бот (необязательно) ────────────────────────────────────
# Токен включает и бота, и оплату через Telegram Stars.
BOT_TOKEN=

# ── платёжные модули (необязательно) ────────────────────────────────
PAY_CRYPTOBOT_TOKEN=
PAY_CRYPTOBOT_ASSET=USDT
PAY_MANUAL_CURRENCIES=USD,RUB
PAY_MANUAL_INSTRUCTIONS=Свяжитесь с поддержкой — подскажем реквизиты.

# ── вынос страницы подписки на отдельный сервер ─────────────────────
# На основном сервере оставьте SUB_MODE=db.
# На отдельном: SUB_MODE=api, PANEL_URL=https://panel.example.com
# и тот же SUB_SERVICE_TOKEN.
SUB_MODE=db
SUB_SERVICE_TOKEN=

RUST_LOG=sn_api=info,sn_sub=info,sn_bot=info,sn_worker=info

# Panel only: generate once with openssl rand -hex 32, keep with environment backups.
CABINET_CODE_KEY=
